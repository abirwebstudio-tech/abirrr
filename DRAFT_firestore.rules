rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Helpers ---

    function isValidComment(data) {
      return data.keys().hasAll(['userId', 'userName', 'content', 'createdAt']) 
        && data.keys().size() == 4
        && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() <= 100
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 2000
        && data.createdAt == request.time;
    }

    function isValidDonation(data) {
      return data.keys().hasAll(['amount', 'type', 'createdAt'])
        && data.amount is number && data.amount > 0
        && data.type in ['monthly', 'one-time']
        && data.createdAt == request.time
        // Optional userId if logged in
        && (!('userId' in data) || data.userId == request.auth.uid);
    }

    // --- Collections ---

    // Public Comments
    match /comments/{commentId} {
      allow get: if true;
      allow list: if true; // Publicly viewable
      
      allow create: if isEmailVerified() 
        && isValidId(commentId)
        && isValidComment(incoming());
        
      allow update: if false; // Comments are immutable in this spec
      allow delete: if isAdmin() || isOwner(existing().userId);
    }

    // Donations
    match /donations/{donationId} {
      allow get: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isValidId(donationId)
        && isValidDonation(incoming());
        
      allow update, delete: if isAdmin(); // Only admins can modify/delete donation records
    }

    // Admin Helper (Optional - Placeholder)
    function isAdmin() {
      // For now, allow specific UIDs or a dedicated collection
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
